# Names only. Copy to .env.local and fill in. Never commit .env.local.
KNOWVIA_API_URL=
KNOWVIA_BOOTSTRAP_TOKEN=
SESSION_COOKIE_SECRET=
# Optional. Vercel Blob store (private) for PDFs over 4 MB, up to 15 MB. Without it the limit stays 4 MB.
BLOB_READ_WRITE_TOKEN=

# Public synthetic demo login (POST /api/app/demo, /signin?demo=1). On by default. Read-only, never reaches the
# backend. Credentials are public and fixed in src/server/backend/demo.ts (demo@demo.com / demo123, the only demo account). Set DEMO_LOGIN_ENABLED=false on the host to switch it off.
DEMO_LOGIN_ENABLED=

# Analytics proxy (src/server/analytics, docs/analytics.md). Off unless ANALYTICS_ENABLED is exactly 1.
ANALYTICS_ENABLED=
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=

# Speech to text (Gnani Vachana), used only by /api/app/voice/transcribe. server-only, never NEXT_PUBLIC. Empty = voice falls back to browser speech.
GNANI_API_KEY=
# Spend gate: Gnani runs only when this is exactly true AND the key is set. Empty = off (voice falls back to browser speech). Optional per-household limits per instance: GNANI_STT_PER_HOUR (20), GNANI_STT_PER_DAY (100).
GNANI_STT_ENABLED=

# Chat is switched on in the backend (CHAT_ENABLED + DOCUMENT_READBACK_ENABLED on the CoverSaath API); nothing to set here.
