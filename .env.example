# Names only. Copy to .env.local and fill in. Never commit .env.local.
KNOWVIA_API_URL=
KNOWVIA_BOOTSTRAP_TOKEN=
SESSION_COOKIE_SECRET=

# Public synthetic demo login (POST /api/app/demo, /signin?demo=1). Off unless exactly "true". Read-only, never reaches the
# backend. Credentials are public and fixed in src/server/backend/demo.ts. Set DEMO_LOGIN_ENABLED=true on the host to allow it.
DEMO_LOGIN_ENABLED=

# Analytics proxy (src/server/analytics, docs/analytics.md). Off unless ANALYTICS_ENABLED is exactly 1.
ANALYTICS_ENABLED=
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=

# Speech to text (Gnani Vachana), used only by /api/app/voice/transcribe. server-only, never NEXT_PUBLIC. Empty = voice falls back to browser speech.
GNANI_API_KEY=

# Chat is switched on in the backend (CHAT_ENABLED + DOCUMENT_READBACK_ENABLED on the CoverSaath API); nothing to set here.
