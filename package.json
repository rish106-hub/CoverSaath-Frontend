{
  "name": "knowvia-frontend",
  "version": "0.1.0",
  "description": "Knowvia web app: a consent-first health insurance helper for Indian families.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rish106-hub/CoverSaath-Frontend.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "analyze:size": "node scripts/analyze-size.mjs",
    "dry-run": "tsx --conditions=react-server scripts/dry-run.ts",
    "verify:persistence": "tsx --conditions=react-server scripts/verify-persistence.ts"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cmdk": "^1.1.1",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "simple-icons": "^16.36.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
